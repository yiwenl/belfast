{
  "name": "belfast-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Belfast WebGPU library monorepo",
  "scripts": {
    "build": "pnpm --filter belfast build",
    "dev": "pnpm --filter belfast dev",
    "dev:example": "pnpm --filter @belfast/example-triangle dev",
    "dev:all": "pnpm --parallel --filter belfast --filter @belfast/example-triangle dev",
    "typecheck": "pnpm --filter belfast typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yiwenl/belfast.git"
  },
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
