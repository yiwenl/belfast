{
  "name": "belfast-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Belfast wgpu library (Rust + WebAssembly)",
  "scripts": {
    "build:wasm": "pnpm --filter @belfast/wasm build",
    "dev": "pnpm build:wasm && pnpm --filter @belfast/web-examples dev",
    "build": "pnpm build:wasm && pnpm --filter @belfast/web-examples build",
    "typecheck": "pnpm --filter @belfast/web-examples typecheck",
    "pack:check": "pnpm --filter @belfast/wasm pack:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yiwenl/belfast.git"
  },
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.5.3"
  }
}
