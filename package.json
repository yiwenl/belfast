{
  "name": "belfast-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Belfast WebGPU library monorepo",
  "scripts": {
    "build": "pnpm --filter belfast build",
    "dev": "pnpm --filter belfast dev",
    "dev:example": "node scripts/dev-example.mjs",
    "dev:all": "node scripts/dev-example.mjs --all",
    "examples": "node scripts/list-examples.mjs",
    "typecheck": "pnpm --filter belfast typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yiwenl/belfast.git"
  },
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.5.3"
  }
}
